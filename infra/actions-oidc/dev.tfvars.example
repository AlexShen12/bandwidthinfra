# Obtain these from the approved AWS administrator. Terraform does not contain keys.
expected_account_id = "123456789012"
region              = "us-west-2"
bedrock_model_id    = "openai.gpt-oss-120b-1:0"

# First configure repo/ref/workflow_ref subject customization; inspect the actual sub.
# Newer repositories also include immutable IDs in the repo segment.
github_oidc_subject          = "repo:AlexShen12/bandwidthinfra:ref:refs/heads/main:workflow_ref:AlexShen12/bandwidthinfra/.github/workflows/infra-review.yml@refs/heads/main"
existing_oidc_provider_arn   = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
create_oidc_provider         = false
