# InfrastructureAgent: export these variables explicitly; the CLI does not load .env.
GITHUB_TOKEN=
# Required only for local --post using an App installation token.
GITHUB_APP_SLUG=
INFRA_TRIGGER=@bandwidth-infra-reviewer
BEDROCK=fake
BEDROCK_AUTH_MODE=api-key
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
AWS_BEARER_TOKEN_BEDROCK=
# IAM-mode local credential chain; Actions uses the configured OIDC role instead.
AWS_PROFILE=default
# Set only after confirming the approved account/role.
HOSTING_ACCOUNT_ID=
BEDROCK_ROLE_ARN=
